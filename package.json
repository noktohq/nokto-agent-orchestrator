{
  "name": "nokto-agent-orchestrator",
  "version": "1.0.0",
  "description": "AI-agenter som leverer kode via pull request — Claude Code + Codex med worktree-isolasjon, command-allowlist og hemmelighetsskanning",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noktohq/nokto-agent-orchestrator.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "bin": {
    "nokto-agent": "./dist/cli.js"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.7.0",
    "prettier": "^3.3.3",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}

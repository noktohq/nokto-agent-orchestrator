# nokto-agent-orchestrator — miljøvariabler.
# Kopier til .env (aldri commit .env) eller sett i shell/CI-hemmeligheter.
# Alle variabler er valgfrie med trygge standardverdier med mindre annet er nevnt.

# --- Repo / tilstand ---
# Roten av git-repoet orkestratoren opererer på.
# Standard: denne pakkens egen rot. Må inneholde en .git-mappe.
AGENT_ORCH_REPO_ROOT=

# Hvor oppgavetilstand (JSON, gjenopptagbar), auditlogg (JSONL) og git-worktrees
# lagres. Standard: .state/, audit/, .worktrees/ i denne pakken. Aldri committet.
AGENT_ORCH_STATE_DIR=
AGENT_ORCH_AUDIT_DIR=
AGENT_ORCH_WORKTREE_DIR=

# Kommaseparerte kvalitets-/sikkerhetsprofilfiler (relative til repo-roten) som
# LLM-planvalideringen vurderer planer mot. Tom = kun statisk validering.
AGENT_PROFILE_FILES=

# --- Claude Code (planlegger / gjennomgang) ---
AGENT_CLAUDE_BIN=claude
# Modellnavn hardkodes ALDRI i kildekoden. Utelates denne, brukes claude-CLI-ens
# egen standardmodell. Sett kun for å eksplisitt overstyre.
AGENT_CLAUDE_MODEL=
# Maks kostnad (USD) per enkelt claude -p-kall. Utelatt: ingen CLI-håndhevet grense.
AGENT_CLAUDE_MAX_BUDGET_USD=
# Timeout i sekunder per claude-kall. Standard: 900 (15 min).
AGENT_CLAUDE_TIMEOUT_SEC=900

# --- OpenAI Codex (implementerer / sekundær kontroll) ---
AGENT_CODEX_BIN=codex
AGENT_CODEX_MODEL=
# read-only | workspace-write. ALDRI danger-full-access — den verdien er
# hardblokkert i src/config.ts uansett hva som settes her.
AGENT_CODEX_SANDBOX=workspace-write
# Timeout i sekunder per codex-kall. Standard: 1800 (30 min).
AGENT_CODEX_TIMEOUT_SEC=1800

# --- Google Gemini (kodegjennomgang / sekundær kontroll, via @google/genai) ---
# API-nøkkel fra Google AI Studio. Uten den rapporterer doctor Gemini som
# utilgjengelig, og gjennomgangsrollene rutes til de andre leverandørene.
# Gemini brukes ALDRI som implementerende agent (API-et har ingen CLI-sandbox
# og kan strukturelt sett ikke endre filer).
GEMINI_API_KEY=
# Gemini-API-et krever et eksplisitt modellnavn per kall. Standard:
# gemini-3.5-flash. Sett for å overstyre — eksakte modellnavn endres over tid.
GEMINI_MODEL=
# Timeout i sekunder per Gemini-kall. Standard: 600 (10 min).
AGENT_GEMINI_TIMEOUT_SEC=600

# --- GitHub (branch / PR / labels) ---
# Personal access token eller GitHub App-token med repo-scope. Kreves for at
# orkestratoren selv skal kunne åpne pull requests. Uten den stopper
# arbeidsflyten før PR-opprettelse (fase "completed", ikke "pr_created") —
# ingen falsk suksess simuleres.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
# Utledes automatisk fra `git remote get-url origin` dersom utelatt.
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
